    "better-auth": "^1.2.7",
    "bullmq": "^5.13.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.20",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ontime/config": "workspace:*",
    "@types/node": "^22.10.2",
    "bun-types": "^1.1.0",
    "typescript": "^5.7.3"
